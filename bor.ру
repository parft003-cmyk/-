# ============ СОСТОЯНИЯ ============
class Registration(StatesGroup):
    gender = State()
    age = State()


class ChatStates(StatesGroup):
    choosing_room = State()
    searching = State()
    in_chat = State()


# ============ ГЛОБАЛЬНОЕ СОСТОЯНИЕ ============
active_searches = {}   
active_chats = {}      


# ============ ХЕЛПЕРЫ ============
def user_ctx(user_id: int) -> FSMContext:
    return FSMContext(
        storage=dp.storage,
        key=StorageKey(bot_id=bot.id, chat_id=user_id, user_id=user_id)
    )


def get_gender(user_id: int):
    r = db_query("SELECT gender FROM users WHERE user_id = ?", (user_id,), fetchone=True)
    return r[0] if r else None


async def _do_match(uid: int, target_gender, room: str):
    my_gender = get_gender(uid)
    peer_id = None


    for sid, info in list(active_searches.items()):
        if sid == uid: continue
        if info['room'] != room: continue
        if target_gender and info.get('gender') != target_gender: continue
        if info.get('target_gender') and info['target_gender'] != my_gender: continue
        
        peer_id = sid
        del active_searches[peer_id]
        break


    if peer_id is None:
        active_searches[uid] = {
            "target_gender": target_gender,
            "room": room,
            "gender": my_gender,
        }
        return


    active_chats[uid] = peer_id
    active_chats[peer_id] = uid


    await user_ctx(uid).set_state(ChatStates.in_chat)
    await user_ctx(peer_id).set_state(ChatStates.in_chat)


    # Обновленный текст при нахождении (как на скрине)
    match_text = (
        "Нашёл кое-кого для тебя! 🍍\n\n"
        "🔄 /next — переключить собеседника.\n"
        "🛑 /stop — остановить диалог.\n\n"
        "Общайтесь, но соблюдайте правила!"
    )
    
    await bot.send_message(uid, match_text, reply_markup=get_chat_inline_keyboard(uid, peer_id))
    await bot.send_message(peer_id, match_text, reply_markup=get_chat_inline_keyboard(peer_id, uid))


async def stop_or_next_chat(uid, peer_id, is_next=False, state=None):
    if active_chats.get(uid) == peer_id:
        active_chats.pop(uid, None)
    if active_chats.get(peer_id) == uid:
        active_chats.pop(peer_id, None)
    active_searches.pop(uid, None)


    for user in (uid, peer_id):
        try:
            await user_ctx(user).set_state(ChatStates.choosing_room)
            await bot.send_message(user, "Диалог остановлен 😫", reply_markup=get_main_menu())
        except Exception:
            pass


    if is_next and state:
        s_data = await state.get_data()
        room = s_data.get("current_room", "Общение")
        await state.set_state(ChatStates.searching)
        try:
            await bot.send_message(uid, "🔍 Ищу нового собеседника...", reply_markup=types.ReplyKeyboardRemove())
        except Exception:
            pass
        await _do_match(uid, None, room)


