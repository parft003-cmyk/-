@dp.message(F.text.in_(["Найти 🤵", "Рандом 🧑‍🤝‍🧑", "Найти 👩"]))
async def start_search(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    u = db_query("SELECT vip, penalty_until FROM users WHERE user_id = ?", (uid,), fetchone=True)


    if u and u[1] > time.time():
        remains = int(u[1] - time.time())
        return await message.answer(f"⚠️ Поиск заблокирован из-за жалоб. Подождите {remains} сек.")


    target_gender = None
    if "🤵" in message.text: target_gender = "M"
    elif "👩" in message.text: target_gender = "F"


    # Проверка на VIP для поиска по полу
    if target_gender and (not u or u[0] == 0):
        return await message.answer(
            "🔒 Поиск по полу доступен только пользователям с 👑 VIP статусом!\n\n"
            "Купите VIP или используйте кнопку «Рандом 🧑‍🤝‍🧑»."
        )


    s_data = await state.get_data()
    room = s_data.get("current_room", "Общение")


    await message.answer("🔍 Ищу собеседника...", reply_markup=types.ReplyKeyboardRemove())
    await state.set_state(ChatStates.searching)
    await _do_match(uid, target_gender, room)


# Обработка команд /next и /stop текстом
@dp.message(Command("stop"))
async def cmd_stop(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    peer_id = active_chats.get(uid)
    if peer_id:
        await stop_or_next_chat(uid, peer_id, is_next=False, state=state)


@dp.message(Command("next"))
async def cmd_next(message: types.Message, state: FSMContext):
    uid = message.from_user.id
    peer_id = active_chats.get(uid)
    if peer_id:
        await stop_or_next_chat(uid, peer_id, is_next=True, state=state)
    else:
        await start_search(message, state)


@dp.callback_query(F.data.startswith("chat_"))
async def handle_chat_buttons(callback: types.CallbackQuery, state: FSMContext):
    try:
        _, action, uid_s, peer_s = callback.data.split("_")
        uid, peer_id = int(uid_s), int(peer_s)
    except Exception:
        return await callback.answer()


    if callback.from_user.id != uid:
        return await callback.answer("Это не ваша кнопка!", show_alert=True)


    if action in ("stop", "next"):
        await callback.answer()
        await stop_or_next_chat(uid, peer_id, is_next=(action=="next"), state=state)


@dp.message(ChatStates.in_chat)
async def relay_message(message: types.Message):
    peer_id = active_chats.get(message.from_user.id)
    if not peer_id:
        return
    try:
        if message.text:
            await bot.send_message(peer_id, message.text)
        elif message.photo:
            await bot.send_photo(peer_id, message.photo[-1].file_id, caption=message.caption)
        elif message.voice:
            await bot.send_voice(peer_id, message.voice.file_id)
        elif message.video_note:
            await bot.send_video_note(peer_id, message.video_note.file_id)
        elif message.sticker:
            await bot.send_sticker(peer_id, message.sticker.file_id)
        elif message.video:
            await bot.send_video(peer_id, message.video.file_id, caption=message.caption)
        elif message.document:
            await bot.send_document(peer_id, message.document.file_id, caption=message.caption)
        elif message.animation:
            await bot.send_animation(peer_id, message.animation.file_id, caption=message.caption)
        elif message.audio:
            await bot.send_audio(peer_id, message.audio.file_id)
    except Exception as e:
        logging.warning(f"Relay error: {e}")


